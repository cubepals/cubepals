{
  "name": "blockly",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "packageManager": "bun@1.3.11",
  "engines": {
    "node": ">=22.18"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run scripts/dev.ts",
    "dev:accounts": "bun run scripts/dev-accounts.ts",
    "dev:lan": "bun run scripts/dev-lan.ts",
    "devtools": "bun --hot apps/devtools/server.ts",
    "dev:control": "bun run --cwd apps/control dev",
    "dev:web": "bun run --cwd apps/web dev",
    "db:generate": "bun run --cwd packages/db generate",
    "db:migrate": "bun run --cwd packages/db migrate",
    "typecheck": "bun run scripts/typecheck.ts",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "bun test",
    "smoke": "bun run scripts/smoke.ts",
    "check:boundaries": "bun run scripts/check-boundaries.ts",
    "check:deprecated": "node scripts/check-deprecated.ts",
    "check:move-only": "bun run scripts/check-move-only.ts",
    "check:structure": "bun run scripts/check-structure.ts",
    "gates": "bun run lint && bun run typecheck && bun run check:boundaries && bun run check:structure && bun run check:deprecated && bun test",
    "openapi:install": "bun install --cwd tools/openapi --frozen-lockfile",
    "openapi:generate": "bun tools/openapi/openapi.ts generate",
    "openapi:check": "bun tools/openapi/openapi.ts check",
    "openapi:update": "bun tools/openapi/openapi.ts update"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "3.1145.0",
    "@biomejs/biome": "2.5.15",
    "@polar-sh/sdk": "1.0.2",
    "@types/bun": "1.4.2",
    "@types/node": "22.20.5",
    "jscpd": "5.4.0",
    "knip": "6.40.0",
    "smol-toml": "1.9.0",
    "typescript": "7.0.2"
  },
  "trustedDependencies": [
    "@fails-components/webtransport-transport-http3-quiche"
  ]
}
