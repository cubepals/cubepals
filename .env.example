# Local development (docs/local-development.md): `cp .env.example .env` and nothing else to fill.
# The secrets below start with local-only-: anyone can read them, so a deployment refuses them.
# `bun run scripts/dev-env.ts` writes .env with fresh ones instead. Values are quoted wherever a
# shell would split them, so `source .env` reads the file as node's --env-file does.
# Every domain, origin and port lives here; nothing in the code names a deployment.

DEPLOYMENT_ID=local
ROLES=api,worker,realtime
DATABASE_URL=postgres://blockly:blockly@127.0.0.1:5432/blockly

# The web app. Browsers reach the API through its /api rewrite, so cookies stay host-only.
WEB_CANONICAL_ORIGIN=http://localhost:3000
# Other origins that serve this environment's web app, comma-separated. On staging, the team's
# preview pattern, such as https://blockly-*-<team>.vercel.app; never a bare *.vercel.app.
WEB_TRUSTED_ORIGINS=

API_LISTEN=127.0.0.1:4000
INTERNAL_LISTEN=127.0.0.1:4001

REALTIME_LISTEN=127.0.0.1:7443
REALTIME_PUBLIC_URL=https://127.0.0.1:7443/
REALTIME_FALLBACK_LISTEN=127.0.0.1:7444
REALTIME_FALLBACK_URL=ws://127.0.0.1:7444/transport-io
# pinned: a self-signed certificate browsers pin by hash (local, staging). acme: the realtime
# role gets a CA certificate over DNS-01 itself (production); then REALTIME_TLS_HOSTNAME is the
# host in REALTIME_PUBLIC_URL, with an A record and no AAAA, and these apply:
#   ACME_DIRECTORY_URL (default Let's Encrypt production), ACME_EMAIL, ACME_AGREE_TOS=true,
#   CLOUDFLARE_DNS_API_TOKEN (DNS edit on the zone only), CLOUDFLARE_ZONE_ID.
REALTIME_TLS_MODE=pinned
REALTIME_TLS_HOSTNAME=localhost
REALTIME_TICKET_SECRET=local-only-realtime-ticket-secret

# Players join <slug>.PLAY_DOMAIN. *.localhost resolves on macOS and systemd Linux; elsewhere use
# 127.0.0.1.nip.io.
PLAY_DOMAIN=play.localhost
PLAY_DOMAIN_ALIASES=
PLAY_PORT=25565

# One region, named for where servers really run: this machine's Docker. To try the create page's
# region picker and Settings → Location's move, set REGIONS="eu:Europe,us:North America" (both
# still on this machine). The map keeps eu and us so servers made under them still start.
REGIONS="local:This computer"
RUNTIME_PROVIDER=docker
RUNTIME_REGION_MAP=local:local,eu:local,us:local
# The country the web app reads from x-vercel-ip-country (Cloudflare's, as OpenNext passes it on),
# which no request has here: US starts new servers in North America, DE in Europe. Empty starts
# them in the first region.
DEV_COUNTRY=
DOCKER_SOCKET=/var/run/docker.sock
DOCKER_GAME_NETWORK=blockly-games
# RUNTIME_PROVIDER=fly: the Fly org this deployment owns, a token from `fly tokens create org`,
# and the org's log stream. [fdaa::3] works inside the org's network; from a laptop joined with
# `fly wireguard`, use your peer's org prefix ending in ::3.
# FLY_ORG=
# FLY_API_TOKEN=
# FLY_NATS_URL=nats://[fdaa::3]:4223
# RUNTIME_PROVIDER=boat: a Boat API key (docs/boat-runtime-plan.md). A paid plan leaves
# BOAT_RUN_TTL_SECONDS unset, so only Blockly stops a server; the trial needs 7200 or less.
# BOAT_API_TOKEN=
# BOAT_RUN_TTL_SECONDS=
# BOAT_START_RESERVE=0.1
# Several runtimes at once (docs/runtimes.md): every one the deployment runs, the default among
# them. RUNTIME_REGION_MAP is the default's alone: every other one needs its own <NAME>_REGION_MAP,
# naming only the regions it serves. OPERATOR_TOKEN is the operators' API's token.
# RUNTIME_PROVIDERS=docker,fleet
# FLEET_REGION_MAP=local:local
# OPERATOR_TOKEN=
RUNTIME_SECRETS_KEY=local-only-runtime-secrets-key
# While rotating the key (docs/configuration.md): the new one as 2:<key>, the old one kept here.
# RUNTIME_SECRETS_PREVIOUS_KEYS=1:<old key>

# Game containers fetch mod files from the control plane through this address.
ARTIFACTS_RUNTIME_FACING_URL=http://host.docker.internal:4000
ARTIFACTS_MIRROR=false

AUTH_SECRET=local-only-auth-secret-for-this-computer
AUTH_GITHUB_CLIENT_ID=
AUTH_GITHUB_CLIENT_SECRET=
# Google sign-in: an OAuth client (web application) per environment, with the redirect URI
# <WEB_CANONICAL_ORIGIN>/api/auth/callback/google. Leave both empty to offer email only.
AUTH_GOOGLE_CLIENT_ID=
AUTH_GOOGLE_CLIENT_SECRET=
# Previews sign in with Google through WEB_CANONICAL_ORIGIN's callback; this secret (16+
# characters, one per environment) encrypts what the canonical origin hands back to a preview.
# Empty turns it off: previews then sign in with email only.
AUTH_OAUTH_PROXY_SECRET=
# The web tier sends each browser's address with this secret (the same value on both apps), and
# the control plane believes that address only with it: sign-in's limits count by address. Empty
# locally, where everyone is localhost.
WEB_PROXY_SECRET=
# Platform admins, comma-separated: an account becomes one once its email is confirmed, and
# stops being one when its email is taken off this list. Admins can make others admins too.
ADMIN_EMAILS=

# Mailpit catches every email: http://localhost:8025
SMTP_URL=smtp://127.0.0.1:1025
MAIL_FROM="Cubepals <hello@blockly.localhost>"

EDGE_TOKEN=local-only-edge-token

# Optional: an S3-compatible store turns on archives and uploads. `docker compose up` runs one
# locally (RustFS); leave ARCHIVE_S3_ENDPOINT empty to run without archives.
ARCHIVE_S3_ENDPOINT=http://127.0.0.1:9000
# Game containers reach the host's store by this name, and links for them are signed for it.
ARCHIVE_S3_RUNTIME_ENDPOINT=http://host.docker.internal:9000
ARCHIVE_S3_BUCKET=blockly-local
ARCHIVE_S3_ACCESS_KEY_ID=blockly
ARCHIVE_S3_SECRET_ACCESS_KEY=blockly-local-secret

# Optional: Polar billing. Locally, the local checkout takes payments whatever is below: Polar's
# webhooks never reach this machine. LOCAL_BILLING=polar uses Polar's sandbox instead, when every
# value below is set. A deployment without them takes no payments: plans come from the account's
# plan column alone. Name the
# server explicitly (sandbox or production); POLAR_PRODUCTS maps each paid plan to its product,
# e.g. plus:<product id>. The token is an organization access token with checkouts:write,
# customer_sessions:write, customers:read and subscriptions:read (staging's scripts also use
# webhooks:read and webhooks:write). The webhook endpoint uses API version 2026-04 and sends
# customer.state_changed, order.paid and order.refunded.
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
POLAR_SERVER=sandbox
POLAR_PRODUCTS=
LOCAL_BILLING=

# Optional: PostHog (docs/metrics.md, Insight). Empty sends nothing. To try it locally, set the
# project's public token here and, for the browser, NEXT_PUBLIC_POSTHOG_TOKEN in apps/web/.env.local;
# events say environment=development, which the project's charts leave out.
POSTHOG_TOKEN=
