{
  "fly_org": "blockly-prod",
  "fly_machine_limit": 20,
  "web": {
    "repository": "cubepals/cubepals",
    "redirects": ["www.cubepals.com"],
    "indexable": true,
    "proxied": false
  },
  "settings": {
    "DEPLOYMENT_ID": "prod",
    "WEB_CANONICAL_ORIGIN": "https://cubepals.com",
    "WEB_TRUSTED_ORIGINS": "",
    "REALTIME_PUBLIC_URL": "https://rt.cubepals.com/",
    "REALTIME_FALLBACK_URL": "wss://rt.cubepals.com/transport-io",
    "REALTIME_TLS_MODE": "acme",
    "REALTIME_TLS_HOSTNAME": "rt.cubepals.com",
    "ACME_DNS_PROVIDER": "cloudflare",
    "PLAY_DOMAIN": "play.cubepals.com",
    "PLAY_DOMAIN_ALIASES": "",
    "PLAY_PORT": "25565",
    "REGIONS": "eu:Europe,us:North America",
    "RUNTIME_PROVIDER": "fly",
    "FLY_ORG": "blockly-prod",
    "RUNTIME_REGION_MAP": "eu:fra,us:iad",
    "ARTIFACTS_MIRROR": "false",
    "ARCHIVE_S3_BUCKET": "your-production-archives-bucket",
    "ARCHIVE_S3_REGION": "auto",
    "MAIL_FROM": "Cubepals <hello@cubepals.com>",
    "POLAR_SERVER": "production",
    "POSTHOG_TOKEN": "phc_your-posthog-project-token"
  },
  "secret_names": [
    "DATABASE_URL",
    "DATABASE_DIRECT_URL",
    "AUTH_SECRET",
    "WEB_PROXY_SECRET",
    "AUTH_GOOGLE_CLIENT_ID",
    "AUTH_GOOGLE_CLIENT_SECRET",
    "REALTIME_TICKET_SECRET",
    "EDGE_TOKEN",
    "OPERATOR_TOKEN",
    "RUNTIME_SECRETS_KEY",
    "FLY_API_TOKEN",
    "SMTP_URL",
    "ARCHIVE_S3_ACCESS_KEY_ID",
    "ARCHIVE_S3_SECRET_ACCESS_KEY",
    "CLOUDFLARE_DNS_API_TOKEN"
  ],
  "optional_secret_names": [
    "POLAR_ACCESS_TOKEN",
    "POLAR_WEBHOOK_SECRET",
    "AUTH_GITHUB_CLIENT_ID",
    "AUTH_GITHUB_CLIENT_SECRET"
  ]
}
