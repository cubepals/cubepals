{
  "fly_org": "blockly-staging",
  "fly_machine_limit": 20,
  "settings": {
    "DEPLOYMENT_ID": "staging",
    "WEB_CANONICAL_ORIGIN": "https://staging.cubepals.com",
    "WEB_TRUSTED_ORIGINS": "",
    "REALTIME_PUBLIC_URL": "https://rt.staging.cubepals.com/",
    "REALTIME_FALLBACK_URL": "wss://rt.staging.cubepals.com/transport-io",
    "REALTIME_TLS_MODE": "pinned",
    "REALTIME_TLS_HOSTNAME": "rt.staging.cubepals.com",
    "PLAY_DOMAIN": "play.staging.cubepals.com",
    "PLAY_DOMAIN_ALIASES": "",
    "PLAY_PORT": "25565",
    "REGIONS": "eu:Europe,us:North America",
    "RUNTIME_PROVIDER": "fly",
    "FLY_ORG": "blockly-staging",
    "RUNTIME_REGION_MAP": "eu:fra,us:iad",
